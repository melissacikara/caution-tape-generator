# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon (public) key — safe in the browser; used for Edge Function invoke
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions only — set in Supabase Dashboard → Edge Functions → Secrets (not in Vite).
# Comma-separated browser origins, e.g. https://your-app.vercel.app,http://localhost:5173
# If unset, CORS uses * (OK for local dev; set both prod + local origins before public launch).
# ALLOWED_ORIGINS=

# Optional — Playwright browser E2E (`npm run test:e2e` from repo root).
# Create a dedicated test user in Supabase (Authentication) with password sign-in enabled.
# E2E_LOGIN_EMAIL=test@example.com
# E2E_LOGIN_PASSWORD=your-test-user-password
